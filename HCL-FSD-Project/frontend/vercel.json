{
  "version": 2,
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source" : "/api(.*)",
      "destination":"https://ordercraft-backend.onrender.com"
    }
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
